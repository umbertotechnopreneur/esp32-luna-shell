{
    "type": "viewTemplate",
    "id": "qsee_metric",
    "node": {
        "type": "container",
        "commonProps": {
            "clickable": false,
            "scrollable": false
        },
        "style": {
            "padding": 0
        },
        "placement": {
            "width": "292dp",
            "height": "38dp"
        },
        "children": [
            {
                "type": "label",
                "id": "name",
                "labelProps": {
                    "text": "METRIC"
                },
                "style": {
                    "textColor": "#20dfc1",
                    "fontSize": "${constant.typography.detail}",
                    "textAlign": "left"
                },
                "placement": {
                    "mode": "absolute",
                    "x": "2dp",
                    "y": 0,
                    "width": "96dp",
                    "height": "22dp"
                }
            },
            {
                "type": "label",
                "id": "value",
                "labelProps": {
                    "text": "UNAVAILABLE"
                },
                "style": {
                    "textColor": "#e7f7ff",
                    "fontSize": "${constant.typography.caption}",
                    "textAlign": "right"
                },
                "placement": {
                    "mode": "absolute",
                    "x": "100dp",
                    "y": "2dp",
                    "width": "190dp",
                    "height": "18dp"
                }
            },
            {
                "type": "progressBar",
                "id": "bar",
                "commonProps": {
                    "hidden": true
                },
                "bindings": {
                    "commonProps.hidden": "hidden",
                    "rangeProps.value": "value"
                },
                "rangeProps": {
                    "value": 0,
                    "min": 0,
                    "max": 100
                },
                "style": {
                    "bgColor": "#1164ad",
                    "radius": "4dp"
                },
                "partStyles": {
                    "indicator": {
                        "bgColor": "#009c9d",
                        "radius": "4dp"
                    }
                },
                "placement": {
                    "mode": "absolute",
                    "x": "2dp",
                    "y": "27dp",
                    "width": "288dp",
                    "height": "6dp"
                }
            }
        ]
    }
}
