     bool called_from_worker = (s_ctx.task && xTaskGetCurrentTaskHandle() == s_ctx.task);
+    if (!called_from_worker && s_ctx.task && s_ctx.pause_done_sem) {
+        xSemaphoreTake(s_ctx.pause_done_sem, 0); /* clear before publishing paused */
+    }
 
     s_ctx.pause_ack = false;
     s_ctx.paused = true;
+    if (!called_from_worker && s_ctx.task) {
+        xTaskNotifyGive(s_ctx.task);
