+            if (rollback_ret == ESP_OK) {
+                s_ctx.paused = false;
+                s_ctx.pause_ack = false;
+            } else {
+                s_ctx.pause_ack = true;
+                ESP_LOGE(TAG, "Failed to restore LVGL tick timer after pause error (%s)",
+                         esp_err_to_name(rollback_ret));
+            }
+            return ret;
+        }
         s_ctx.pause_ack = true;
         if (s_ctx.pause_done_sem) {
             xSemaphoreGive(s_ctx.pause_done_sem);
         }
-        /* Stop the tick timer so tickless light sleep can enter naturally. */
-        (void)adapter_stop_tick_timer();
         return ESP_OK;
     }
 
     if (!s_ctx.task || !s_ctx.pause_done_sem) {
+        esp_err_t ret = adapter_stop_tick_timer();
+        if (ret != ESP_OK) {
+            esp_err_t rollback_ret = adapter_start_tick_timer();
+            if (rollback_ret == ESP_OK) {
+                s_ctx.paused = false;
+                s_ctx.pause_ack = false;
+            } else {
+                s_ctx.pause_ack = true;
+                ESP_LOGE(TAG, "Failed to restore LVGL tick timer after pause error (%s)",
+                         esp_err_to_name(rollback_ret));
+            }
+            return ret;
+        }
         s_ctx.pause_ack = true;
-        (void)adapter_stop_tick_timer();
         return ESP_OK;
     }
 
-    xSemaphoreTake(s_ctx.pause_done_sem, 0); /* clear pending */
     TickType_t ticks = (timeout_ms < 0) ? portMAX_DELAY : pdMS_TO_TICKS(timeout_ms);
     if (xSemaphoreTake(s_ctx.pause_done_sem, ticks) != pdTRUE) {
         s_ctx.paused = false;
+        s_ctx.pause_ack = false;
+        xTaskNotifyGive(s_ctx.task);
         return ESP_ERR_TIMEOUT;
     }
-    (void)adapter_stop_tick_timer();
+    esp_err_t ret = adapter_stop_tick_timer();
+    if (ret != ESP_OK) {
+        esp_err_t rollback_ret = adapter_start_tick_timer();
+        if (rollback_ret == ESP_OK) {
+            s_ctx.paused = false;
+            s_ctx.pause_ack = false;
+            xTaskNotifyGive(s_ctx.task);
+        } else {
+            ESP_LOGE(TAG, "Failed to restore LVGL tick timer after pause error (%s)",
+                     esp_err_to_name(rollback_ret));
+        }
+        return ret;
+    }
     return ESP_OK;
 }
 
