                    },
                    {
                      "type": "container",
                      "id": "right_cheek",
                      "commonProps": { "clickable": false },
                      "bindings": { "commonProps.hidden": "hidden" },
                      "style": { "bgColor": "#ff8ca4", "radius": "5dp", "padding": 0 },
                      "placement": {
                        "mode": "absolute", "x": "151dp", "y": "129dp",
                        "width": "10dp", "height": "9dp"
                      }
                    }
                  ]
                }
              ]
            }
          ]
        }
      ]
