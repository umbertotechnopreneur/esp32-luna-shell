                      "style": { "bgColor": "#071423", "padding": 0 },
                      "placement": {
                        "mode": "absolute", "x": "88dp", "y": "107dp",
                        "width": "6dp", "height": "13dp"
                      }
                    },
                    {
                      "type": "container",
                      "id": "right_eye",
                      "commonProps": { "clickable": false },
