            "data": {
                "typography": {
                    "available": [
                        "8sp",
                        "10sp",
                        "12sp",
                        "16sp",
                        "20sp",
                        "24sp",
                        "32sp"
                    ],
                    "micro": "10sp",
                    "caption": "12sp",
                    "detail": "16sp",
                    "body": "20sp",
                    "heading": "24sp",
                    "control": "24sp",
                    "title": "32sp"
                }
            }
        },
