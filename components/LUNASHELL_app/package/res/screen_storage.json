                                    "style": {
                                        "textColor": "#9fb1c1",
                                        "fontSize": "${constant.typography.heading}",
                                        "textAlign": "left"
                                    },
                                    "placement": {
                                        "width": "282dp",
                                        "height": "26dp"
                                    }
