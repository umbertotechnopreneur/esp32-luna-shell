                                    "placement": {
                                        "width": "282dp",
                                        "height": "18dp"
                                    }
                                },
                                {
                                    "type": "container",
                                    "id": "total_row",
                                    "commonProps": {
                                        "scrollable": false
                                    },
                                    "layout": {
                                        "type": "flex",
                                        "flexFlow": "row",
                                        "mainAlign": "spaceBetween",
                                        "crossAlign": "center"
                                    },
                                    "placement": {
                                        "width": "282dp",
                                        "height": "24dp"
                                    },
                                    "children": [
                                        {
                                            "type": "label",
                                            "id": "label",
                                            "labelProps": {
                                                "text": "TOTAL SPACE"
                                            },
                                            "style": {
                                                "textColor": "#9fb1c1",
                                                "fontSize": "${constant.typography.detail}"
                                            }
                                        },
                                        {
                                            "type": "label",
                                            "id": "value",
                                            "labelProps": {
                                                "text": "UNAVAILABLE"
                                            },
                                            "style": {
                                                "textColor": "#f3f7fa",
                                                "fontSize": "${constant.typography.detail}",
                                                "textAlign": "right"
                                            }
                                        }
                                    ]
                                },
                                {
                                    "type": "container",
                                    "id": "free_row",
                                    "commonProps": {
                                        "scrollable": false
                                    },
                                    "layout": {
                                        "type": "flex",
                                        "flexFlow": "row",
                                        "mainAlign": "spaceBetween",
                                        "crossAlign": "center"
                                    },
                                    "placement": {
                                        "width": "282dp",
                                        "height": "24dp"
                                    },
                                    "children": [
                                        {
                                            "type": "label",
                                            "id": "label",
                                            "labelProps": {
                                                "text": "FREE SPACE"
                                            },
                                            "style": {
                                                "textColor": "#9fb1c1",
                                                "fontSize": "${constant.typography.detail}"
                                            }
                                        },
                                        {
                                            "type": "label",
                                            "id": "value",
                                            "labelProps": {
                                                "text": "UNAVAILABLE"
                                            },
                                            "style": {
                                                "textColor": "#f3f7fa",
                                                "fontSize": "${constant.typography.detail}",
                                                "textAlign": "right"
                                            }
                                        }
                                    ]
                                },
                                {
                                    "type": "progressBar",
                                    "id": "usage_bar",
                                    "commonProps": {
                                        "hidden": true
                                    },
                                    "bindings": {
                                        "commonProps.hidden": "hidden",
                                        "rangeProps.value": "value"
                                    },
                                    "rangeProps": {
                                        "value": 0,
                                        "min": 0,
                                        "max": 100
                                    },
                                    "style": {
                                        "bgColor": "#0b1e2c",
                                        "radius": "6dp"
                                    },
                                    "partStyles": {
                                        "indicator": {
                                            "bgColor": "#20dfc1",
                                            "radius": "6dp"
                                        }
                                    },
                                    "placement": {
                                        "width": "282dp",
                                        "height": "12dp"
                                    }
                                },
                                {
                                    "type": "label",
                                    "id": "usage_value",
                                    "labelProps": {
                                        "text": "Space is unavailable until the card is mounted."
                                    },
                                    "style": {
                                        "textColor": "#8aa7b6",
                                        "fontSize": "${constant.typography.caption}",
                                        "textAlign": "center"
                                    },
                                    "placement": {
                                        "width": "282dp",
                                        "height": "wrap"
                                    }
                                },
                                {
                                    "type": "button",
                                    "id": "format_action",
                                    "commonProps": {
                                        "pressLock": false,
                                        "disabled": true
                                    },
                                    "bindings": {
                                        "commonProps.disabled": "format_disabled"
                                    },
                                    "events": [
                                        {
                                            "type": "clicked",
                                            "action": "LUNASHELL.storage.format"
                                        }
                                    ],
                                    "style": {
                                        "bgColor": "#b52b3a",
                                        "borderColor": "#ff8a96",
                                        "borderWidth": "1dp",
                                        "radius": "10dp",
                                        "padding": 0
                                    },
                                    "stateStyles": {
                                        "pressed": {
                                            "bgColor": "#8f1f2c",
                                            "borderColor": "#ffc1c7",
                                            "borderWidth": "1dp"
                                        },
                                        "disabled": {
                                            "bgColor": "#263744",
                                            "borderColor": "#546874",
                                            "opacity": 140
                                        }
                                    },
                                    "placement": {
                                        "width": "210dp",
                                        "height": "44dp"
                                    },
                                    "children": [
                                        {
                                            "type": "label",
                                            "id": "label",
                                            "commonProps": {
                                                "clickable": false,
                                                "scrollable": false
                                            },
                                            "labelProps": {
                                                "text": "FORMAT UNAVAILABLE"
                                            },
                                            "style": {
                                                "textColor": "#ffffff",
                                                "fontSize": "${constant.typography.detail}",
                                                "textAlign": "center"
                                            },
                                            "placement": {
                                                "mode": "relative",
                                                "align": "center"
                                            }
                                        }
                                    ]
                                },
                                {
                                    "type": "label",
                                    "id": "format_note",
                                    "labelProps": {
                                        "text": "Formatting is enabled only for a verified card that explicitly requires it."
                                    },
                                    "style": {
                                        "textColor": "#f0b44d",
                                        "fontSize": "${constant.typography.caption}",
                                        "textAlign": "center"
                                    },
                                    "placement": {
                                        "width": "282dp",
                                        "height": "wrap"
                                    }
                                }
                            ]
                        }
                    ]
                }
            ]
        }
    ]
