                                    "placement": {
                                        "width": "282dp",
                                        "height": "16dp"
                                    }
                                },
                                {
                                    "type": "label",
                                    "id": "status_title",
                                    "labelProps": {
                                        "text": "CURRENT STATUS"
                                    },
                                    "style": {
                                        "textColor": "#00e7c5",
                                        "fontSize": "${constant.typography.body}",
                                        "textAlign": "left"
                                    },
                                    "placement": {
                                        "width": "282dp",
                                        "height": "20dp"
                                    }
                                },
                                {
                                    "type": "label",
                                    "id": "status_value",
                                    "bindings": {
                                        "style.textColor": "status_color"
