                                        "text": "Waiting for the storage snapshot."
                                    },
                                    "style": {
                                        "textColor": "#d6efff",
                                        "fontSize": "${constant.typography.caption}",
                                        "textAlign": "left"
                                    },
                                    "placement": {
                                        "width": "282dp",
                                        "height": "wrap"
                                    }
                                },
                                {
                                    "type": "label",
                                    "id": "mount_value",
                                    "labelProps": {
                                        "text": "NOT MOUNTED"
                                    },
                                    "style": {
                                        "textColor": "#51c7f2",
                                        "fontSize": "${constant.typography.caption}",
                                        "textAlign": "left"
