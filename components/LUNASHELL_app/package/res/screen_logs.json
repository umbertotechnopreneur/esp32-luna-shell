{
    "version": "0.2.0",
    "assets": [
        {
            "type": "constant",
            "data": {
                "typography": {
                    "available": [
                        "10sp",
                        "12sp",
                        "16sp",
                        "20sp",
                        "24sp",
                        "32sp"
                    ],
                    "micro": "10sp",
                    "caption": "12sp",
                    "detail": "16sp",
                    "body": "20sp",
                    "heading": "24sp",
                    "control": "24sp",
                    "title": "32sp"
                }
            }
        },
        {
            "type": "viewScreen",
            "id": "LUNASHELL_logs",
            "mountMode": "dynamic",
            "commonProps": {
                "scrollable": false
            },
            "style": {
                "padding": 0
            },
            "layout": {
                "type": "flex",
                "mainAlign": "center",
                "crossAlign": "center"
            },
            "children": [
                {
                    "type": "container",
                    "id": "surface",
                    "bindings": {
                        "placement.y": "viewport_y",
                        "placement.height": "viewport_height",
                        "style.paddingTop": "viewport_padding_top",
                        "style.paddingBottom": "viewport_padding_bottom"
                    },
                    "commonProps": {
                        "scrollable": false
                    },
                    "style": {
                        "radius": "28dp",
                        "padding": "10dp",
                        "paddingTop": "48dp",
                        "paddingBottom": "8dp"
                    },
                    "layout": {
                        "type": "flex",
                        "flexFlow": "column",
                        "crossAlign": "center",
                        "gap": "5dp"
                    },
                    "placement": {
                        "mode": "absolute",
                        "align": "topMid",
                        "x": "73dp",
                        "y": "73dp",
                        "width": "320dp",
                        "height": "320dp"
                    },
                    "children": [
                        {
                            "type": "label",
                            "id": "title",
                            "labelProps": {
                                "text": "LIVE LOGS"
                            },
                            "style": {
                                "textColor": "#f3f7fa",
                                "fontSize": "${constant.typography.heading}",
                                "textAlign": "left"
                            },
                            "placement": {
                                "width": "282dp",
                                "height": "26dp"
                            }
                        },
                        {
                            "type": "label",
                            "id": "subtitle",
                            "labelProps": {
                                "text": "Tap a component for details - swipe to scroll"
                            },
                            "style": {
                                "textColor": "#9fb1c1",
                                "fontSize": "${constant.typography.caption}",
                                "textAlign": "left"
                            },
                            "placement": {
                                "width": "282dp",
                                "height": "16dp"
                            }
                        },
                        {
                            "type": "container",
                            "id": "log_scroller",
                            "commonProps": {
                                "scrollable": true
                            },
                            "events": [
                                {
                                    "type": "scroll",
                                    "action": "LUNASHELL.chrome.activity.logs"
                                }
                            ],
                            "style": {
                                "bgColor": "#031933",
                                "borderColor": "#1164ad",
                                "borderWidth": "1dp",
                                "radius": "8dp",
                                "padding": "5dp"
                            },
                            "placement": {
                                "width": "300dp",
                                "flexGrow": 1
                            },
                            "children": [
                                {
                                    "type": "label",
                                    "id": "log_text",
                                    "labelProps": {
                                        "text": "LOGGER UNAVAILABLE\nWAITING FOR CANONICAL SNAPSHOT"
                                    },
                                    "style": {
                                        "textColor": "#9fb1c1",
                                        "fontSize": "${constant.typography.micro}"
                                    },
                                    "placement": {
                                        "mode": "absolute",
                                        "x": "0dp",
                                        "y": "0dp",
                                        "width": "286dp",
                                        "height": "wrap"
                                    }
                                }
                            ]
                        }
                    ]
                }
            ]
        }
    ]
}
