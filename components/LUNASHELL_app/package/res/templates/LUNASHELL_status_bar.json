{
    "type": "viewTemplate",
    "id": "LUNASHELL_status_bar",
    "node": {
        "type": "container",
        "commonProps": {
            "clickable": false,
            "scrollable": false
        },
        "bindings": {
            "style.opacity": "opacity"
        },
        "style": {
            "padding": 0,
            "opacity": 255
        },
        "placement": {
            "mode": "absolute",
            "x": "83dp",
            "y": "2dp",
            "width": "300dp",
            "height": "100dp"
        },
        "animations": [
            {
                "id": "status_mount_fade",
                "trigger": "mount",
                "property": "opacity",
                "from": 0,
                "to": 255,
                "duration": 280,
                "easing": "easeInOut"
            }
        ],
        "children": [
            {
                "type": "label",
                "id": "date_time",
                "commonProps": {
                    "clickable": false,
                    "scrollable": false,
                    "hidden": true
                },
                "bindings": {
                    "commonProps.hidden": "hidden",
                    "labelProps.text": "text",
                    "style.textColor": "color"
                },
                "labelProps": {
                    "text": "TIME UNAVAILABLE"
                },
                "style": {
                    "textColor": "#617f91",
                    "fontSize": "${constant.typography.micro}",
                    "textAlign": "center"
                },
                "placement": {
                    "mode": "absolute",
                    "x": "74dp",
                    "y": "12dp",
                    "width": "152dp",
                    "height": "18dp"
                }
            },
            {
                "type": "templateRef",
                "id": "usb",
                "templateId": "LUNASHELL_status_indicator",
                "overrides": {
                    ".": {
                        "placement": {
                            "x": "30dp",
                            "y": "34dp"
                        }
                    },
                    "icon": {
                        "labelProps": {
                            "text": "\uf287"
                        }
                    }
                }
            },
            {
                "type": "container",
                "id": "battery",
                "commonProps": {
                    "clickable": false,
                    "scrollable": false
