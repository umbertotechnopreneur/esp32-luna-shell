                        "style": {
                            "textColor": "#f4ffff",
                            "fontSize": "${constant.typography.caption}",
                            "textAlign": "center"
                        },
                        "placement": {
                            "mode": "absolute",
                            "x": "23dp",
                            "y": "-1dp",
                            "width": "12dp",
                            "height": "14dp"
                        }
                    },
                    {
                        "type": "label",
                        "id": "value",
                        "bindings": {
                            "labelProps.text": "text",
                            "style.textColor": "color"
