                        "labelProps": {
                            "text": "•"
                        },
                        "style": {
                            "textColor": "#f0b44d",
                            "fontSize": "${constant.typography.body}",
                            "textAlign": "center"
                        },
                        "placement": {
                            "mode": "absolute",
                            "x": 0,
                            "y": "31dp",
                            "width": "34dp",
                            "height": "16dp"
                        }
                    }
                ]
            },
            {
                "type": "templateRef",
                "id": "sd",
                "templateId": "LUNASHELL_status_indicator",
                "overrides": {
                    ".": {
                        "placement": {
