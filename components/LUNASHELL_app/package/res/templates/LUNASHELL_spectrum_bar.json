{
    "type": "viewTemplate",
    "id": "LUNASHELL_spectrum_bar",
    "node": {
        "type": "container",
        "commonProps": {
            "clickable": false,
            "scrollable": false
        },
        "style": {
            "padding": 0
        },
        "layout": {
            "mainAlign": "center",
            "crossAlign": "end"
        },
        "placement": {
            "width": "13dp",
            "height": "98dp"
        },
        "children": [
            {
                "type": "progressBar",
                "id": "bar",
                "bindings": {
                    "rangeProps.value": "value",
                    "partStyles.indicator.style.bgColor": "color"
                },
                "rangeProps": {
                    "value": 0,
                    "min": 0,
                    "max": 100
                },
                "style": {
                    "bgColor": "#0b1e2c",
                    "radius": "0dp"
                },
                "partStyles": {
                    "indicator": {
                        "bgColor": "#27bdf2",
                        "radius": "0dp"
                    }
                },
                "placement": {
                    "width": "7dp",
                    "height": "94dp"
                }
            }
        ]
    }
}
