{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "statusMessage": "Cody: Chat opened",
            "timeout": 8,
            "command": "python -B -c \"import os,runpy,sys; p=os.path.join(os.environ['PLUGIN_ROOT'],'mcp'); sys.path.insert(0,p); runpy.run_path(os.path.join(p,'ccp_server.py'),run_name='__main__')\" --hook",
            "type": "command"
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "statusMessage": "Cody: Follow this chat",
            "timeout": 8,
            "command": "python -B -c \"import os,runpy,sys; p=os.path.join(os.environ['PLUGIN_ROOT'],'mcp'); sys.path.insert(0,p); runpy.run_path(os.path.join(p,'ccp_server.py'),run_name='__main__')\" --hook",
            "type": "command"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "hooks": [
          {
            "statusMessage": "Cody: Tool starting",
            "timeout": 8,
            "command": "python -B -c \"import os,runpy,sys; p=os.path.join(os.environ['PLUGIN_ROOT'],'mcp'); sys.path.insert(0,p); runpy.run_path(os.path.join(p,'ccp_server.py'),run_name='__main__')\" --hook",
            "type": "command"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "hooks": [
          {
            "statusMessage": "Cody: Tool finished",
            "timeout": 8,
            "command": "python -B -c \"import os,runpy,sys; p=os.path.join(os.environ['PLUGIN_ROOT'],'mcp'); sys.path.insert(0,p); runpy.run_path(os.path.join(p,'ccp_server.py'),run_name='__main__')\" --hook",
            "type": "command"
          }
        ]
      }
    ],
    "PermissionRequest": [
      {
        "hooks": [
          {
            "statusMessage": "Cody: Approval on your PC",
            "timeout": 8,
            "command": "python -B -c \"import os,runpy,sys; p=os.path.join(os.environ['PLUGIN_ROOT'],'mcp'); sys.path.insert(0,p); runpy.run_path(os.path.join(p,'ccp_server.py'),run_name='__main__')\" --hook",
            "type": "command"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "statusMessage": "Cody: Reply ready",
            "timeout": 8,
            "command": "python -B -c \"import os,runpy,sys; p=os.path.join(os.environ['PLUGIN_ROOT'],'mcp'); sys.path.insert(0,p); runpy.run_path(os.path.join(p,'ccp_server.py'),run_name='__main__')\" --hook",
            "type": "command"
          }
        ]
      }
    ],
    "Interrupt": [
      {
        "hooks": [
          {
            "statusMessage": "Cody: Work interrupted",
            "timeout": 3,
            "command": "python -B -c \"import os,runpy,sys; p=os.path.join(os.environ['PLUGIN_ROOT'],'mcp'); sys.path.insert(0,p); runpy.run_path(os.path.join(p,'ccp_server.py'),run_name='__main__')\" --hook",
            "type": "command"
          }
        ]
      }
    ],
    "PreCompact": [
      {
        "matcher": "auto|manual",
        "hooks": [
          {
            "statusMessage": "Cody: Compacting context",
            "timeout": 8,
            "command": "python -B -c \"import os,runpy,sys; p=os.path.join(os.environ['PLUGIN_ROOT'],'mcp'); sys.path.insert(0,p); runpy.run_path(os.path.join(p,'ccp_server.py'),run_name='__main__')\" --hook",
            "type": "command"
          }
        ]
      }
    ],
    "PostCompact": [
      {
        "matcher": "auto|manual",
        "hooks": [
          {
            "statusMessage": "Cody: Context refreshed",
            "timeout": 8,
            "command": "python -B -c \"import os,runpy,sys; p=os.path.join(os.environ['PLUGIN_ROOT'],'mcp'); sys.path.insert(0,p); runpy.run_path(os.path.join(p,'ccp_server.py'),run_name='__main__')\" --hook",
            "type": "command"
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "statusMessage": "Cody: Chat closed",
            "timeout": 3,
            "command": "python -B -c \"import os,runpy,sys; p=os.path.join(os.environ['PLUGIN_ROOT'],'mcp'); sys.path.insert(0,p); runpy.run_path(os.path.join(p,'ccp_server.py'),run_name='__main__')\" --hook",
            "type": "command"
          }
        ]
      }
    ]
  }
}
