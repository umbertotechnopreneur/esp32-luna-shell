# Toolchain- and architecture-wide defaults shared by every product profile.
CONFIG_IDF_TARGET="esp32s3"
CONFIG_ESP_DEFAULT_CPU_FREQ_MHZ_240=y
CONFIG_ESP32S3_INSTRUCTION_CACHE_32KB=y
CONFIG_ESP32S3_DATA_CACHE_64KB=y
CONFIG_ESP32S3_DATA_CACHE_LINE_64B=y
CONFIG_COMPILER_OPTIMIZATION_PERF=y
CONFIG_COMPILER_CXX_EXCEPTIONS=y
# The canonical logger and its readback receiver own native USB Serial/JTAG.
CONFIG_ESP_CONSOLE_UART_DEFAULT=n
CONFIG_ESP_CONSOLE_USB_SERIAL_JTAG=y
CONFIG_ESP_CONSOLE_SECONDARY_NONE=y

# Local speech remains excluded unless an explicit feature is selected.
# CONFIG_LUNASHELL_BUILD_ENABLE_TTS is not set

# The public feature selector is the only admission path for local recognition.
# CONFIG_LUNASHELL_BUILD_ENABLE_WAKE_WORD is not set
