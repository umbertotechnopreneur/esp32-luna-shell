# Cody's initial connected base. Display and touch are mandatory hardware.
CONFIG_LUNASHELL_BUILD_PROFILE_CODY_COMPANION=y
# Keep the selected artwork enabled during the current visual iteration.
CONFIG_LUNASHELL_CODY_RENDER_PEARL_JELLY=y
CONFIG_LUNASHELL_CODY_FACE_FOLLOWS_BODY=y
CONFIG_LUNASHELL_CODY_FORCE_FIRST_BOOT=y
CONFIG_LUNASHELL_BUILD_ENABLE_DISPLAY=y
CONFIG_LUNASHELL_BUILD_ENABLE_TOUCH=y
CONFIG_LUNASHELL_BUILD_ENABLE_UI=n
CONFIG_LUNASHELL_BUILD_ENABLE_BOOT_UI=n
CONFIG_LUNASHELL_BUILD_ENABLE_BOOT_AUDIO=n

CONFIG_LUNASHELL_BUILD_ENABLE_WIFI=y
CONFIG_LUNASHELL_BUILD_ENABLE_BLUETOOTH=y
CONFIG_LUNASHELL_BUILD_ENABLE_PROVISIONING=y
# The local rig PoC has no HTTP or companion integration route.
CONFIG_LUNASHELL_BUILD_ENABLE_HTTP_API=n

# Keep the measured motion, power and codec services for the companion.
CONFIG_LUNASHELL_BUILD_ENABLE_POWER_INPUTS=y
CONFIG_LUNASHELL_BUILD_ENABLE_BATTERY=y
CONFIG_LUNASHELL_BUILD_ENABLE_IMU=y
CONFIG_LUNASHELL_BUILD_ENABLE_AUDIO=y
CONFIG_LUNASHELL_BUILD_AUDIO_OUTPUT_DRIVER_ES8311=y
CONFIG_LUNASHELL_BUILD_AUDIO_INPUT_DRIVER_ES7210_DUAL=y
CONFIG_LUNASHELL_BUILD_ENABLE_VOICE_AFE=n
CONFIG_XPOWERS_CHIP_AXP2101=y
CONFIG_XPOWERS_ESP_IDF_NEW_API=y

# Reuse the canonical UTC clock/snapshot owner and existing deferred SNTP sync.
# The board's RTC alarm interrupt is not a direct ESP Deep-sleep wake source.
CONFIG_LUNASHELL_BUILD_RTC_DRIVER_PCF85063=y
CONFIG_LUNASHELL_BUILD_ENABLE_RTC=y

# Firmware exclusion does not physically disconnect the board's GPS power rail.
CONFIG_LUNASHELL_BUILD_ENABLE_GNSS=n
CONFIG_LUNASHELL_BUILD_ENABLE_REMOVABLE_STORAGE=n
CONFIG_LUNASHELL_BUILD_ENABLE_DISTANCE=n
