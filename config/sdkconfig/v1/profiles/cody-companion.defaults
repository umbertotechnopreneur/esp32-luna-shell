# VBWR E

# Device panel with the existing CCP identity. Display and touch are mandatory.
CONFIG_LUNASHELL_BUILD_PROFILE_CODY_COMPANION=y
CONFIG_LUNASHELL_CODY_RENDER_PEARL_JELLY=n
CONFIG_LUNASHELL_CODY_FACE_FOLLOWS_BODY=n
CONFIG_LUNASHELL_CODY_FORCE_FIRST_BOOT=n
# Keep Codex counters, notifications and explicit pairing.
CONFIG_LUNA_SHELL_CODY_ENABLE_CODEX=y
CONFIG_LUNASHELL_BUILD_ENABLE_DISPLAY=y
CONFIG_LUNASHELL_BUILD_ENABLE_TOUCH=y
CONFIG_LUNASHELL_BUILD_ENABLE_UI=n
CONFIG_LUNASHELL_BUILD_ENABLE_BOOT_UI=n
CONFIG_LUNASHELL_BUILD_ENABLE_BOOT_AUDIO=n

CONFIG_LUNASHELL_BUILD_ENABLE_WIFI=y
CONFIG_LUNASHELL_BUILD_ENABLE_BLUETOOTH=y
CONFIG_LUNASHELL_BUILD_ENABLE_PROVISIONING=y
# Keep the official radio/IP tasks together on CPU0. The native Cody frame
# owner is pinned separately to CPU1 in CODY_device_ui.cpp.
CONFIG_ESP_MAIN_TASK_AFFINITY_CPU0=y
CONFIG_ESP_WIFI_TASK_PINNED_TO_CORE_0=y
CONFIG_BT_CTRL_PINNED_TO_CORE_0=y
CONFIG_BT_NIMBLE_PINNED_TO_CORE_0=y
CONFIG_LWIP_TCPIP_TASK_AFFINITY_CPU0=y
CONFIG_LWIP_SNTP_MAX_SERVERS=3
# HTTP selection belongs to the later connectivity feature defaults.
CONFIG_LUNASHELL_BUILD_ENABLE_HTTP_API=n

# Keep orientation, power and speaker notifications. No microphone owner runs.
CONFIG_LUNASHELL_BUILD_ENABLE_POWER_INPUTS=y
CONFIG_LUNASHELL_BUILD_ENABLE_BATTERY=y
CONFIG_LUNASHELL_BUILD_ENABLE_IMU=y
CONFIG_LUNASHELL_BUILD_ENABLE_AUDIO=y
CONFIG_LUNASHELL_BUILD_AUDIO_OUTPUT_DRIVER_ES8311=y
CONFIG_LUNASHELL_BUILD_AUDIO_INPUT_DRIVER_NONE=y
CONFIG_CODEC_ES8311_SUPPORT=y
CONFIG_CODEC_ES7210_SUPPORT=n
CONFIG_LUNASHELL_BUILD_ENABLE_WAKE_WORD=n
CONFIG_LUNASHELL_BUILD_ENABLE_VOICE_AFE=n
CONFIG_LUNASHELL_BUILD_ENABLE_VOICE_INPUT=n
CONFIG_LUNASHELL_BUILD_ENABLE_TTS=n
CONFIG_LUNASHELL_ACTIVITY_MODEL=n
CONFIG_LUNASHELL_ACTIVITY_CAPTURE=n
CONFIG_XPOWERS_CHIP_AXP2101=y
CONFIG_XPOWERS_ESP_IDF_NEW_API=y

# Reuse the canonical UTC clock/snapshot owner and existing deferred SNTP sync.
# The board's RTC alarm interrupt is not a direct ESP Deep-sleep wake source.
CONFIG_LUNASHELL_BUILD_RTC_DRIVER_PCF85063=y
CONFIG_LUNASHELL_BUILD_ENABLE_RTC=y

# Firmware exclusion does not physically disconnect the board's GPS power rail.
CONFIG_LUNASHELL_BUILD_ENABLE_GNSS=n
# Offline diagnostics use the existing SD owner; an absent card remains optional.
CONFIG_LUNASHELL_BUILD_ENABLE_REMOVABLE_STORAGE=y
# The removable slot serves memory cards, not SDIO peripherals. Keep the
# official IDF memory-only sequence; omit unrelated CMD52 reset/CMD5 discovery.
CONFIG_SD_ENABLE_SDIO_SUPPORT=n
# The owned LUNASHELL directory/log filenames require FAT long-name support.
CONFIG_FATFS_LFN_HEAP=y
CONFIG_LUNASHELL_BUILD_ENABLE_DISTANCE=n
