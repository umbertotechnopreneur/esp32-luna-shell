# VBWR E

CONFIG_LUNASHELL_BUILD_PROFILE_LEG_EDITION=y
CONFIG_LUNASHELL_BUILD_ENABLE_UI=y
CONFIG_LUNASHELL_BUILD_ENABLE_BOOT_UI=y
CONFIG_LUNASHELL_BUILD_ENABLE_IMU=y
CONFIG_LUNASHELL_BUILD_ENABLE_POWER_INPUTS=y
CONFIG_LUNASHELL_BUILD_ENABLE_BATTERY=y
CONFIG_LUNASHELL_BUILD_ENABLE_AUDIO=y
CONFIG_LUNASHELL_BUILD_ENABLE_BOOT_AUDIO=y
CONFIG_LUNASHELL_BUILD_AUDIO_OUTPUT_DRIVER_ES8311=y
CONFIG_LUNASHELL_BUILD_AUDIO_INPUT_DRIVER_NONE=y
CONFIG_LUNASHELL_BUILD_ENABLE_REMOVABLE_STORAGE=y
CONFIG_LV_FONT_UNSCII_16=y
# CONFIG_LUNASHELL_BUILD_ENABLE_WIFI is not set
# CONFIG_LUNASHELL_BUILD_ENABLE_BLUETOOTH is not set
# CONFIG_LUNASHELL_BUILD_ENABLE_PROVISIONING is not set
# CONFIG_LUNASHELL_BUILD_ENABLE_HTTP_API is not set
# CONFIG_LUNASHELL_BUILD_ENABLE_GNSS is not set
# CONFIG_LUNASHELL_BUILD_ENABLE_RTC is not set
# CONFIG_LUNASHELL_BUILD_ENABLE_WAKE_WORD is not set
# CONFIG_BT_ENABLED is not set
# Brookesia's Boost.Asio task scheduler needs lwIP IPv6 socket types at compile time.
CONFIG_LWIP_IPV6=y
CONFIG_CODEC_ES8311_SUPPORT=y
# CONFIG_CODEC_ES7210_SUPPORT is not set
# CONFIG_CODEC_ES7243_SUPPORT is not set
# CONFIG_CODEC_ES7243E_SUPPORT is not set
# CONFIG_CODEC_ES8156_SUPPORT is not set
# CONFIG_CODEC_AW88298_SUPPORT is not set
# CONFIG_CODEC_ES8389_SUPPORT is not set
# CONFIG_CODEC_ES8374_SUPPORT is not set
# CONFIG_CODEC_ES8388_SUPPORT is not set
# CONFIG_CODEC_TAS5805M_SUPPORT is not set
# CONFIG_CODEC_ZL38063_SUPPORT is not set
# CONFIG_CODEC_CJC8910_SUPPORT is not set
# CONFIG_CODEC_DUMMY_SUPPORT is not set
# CONFIG_CODEC_DATA_ADC_SUPPORT is not set
