# Mandatory physical display and touch; no Luna application or LVGL backend.
CONFIG_LUNASHELL_BUILD_PROFILE_DISPLAY_TOUCH=y
CONFIG_LUNASHELL_BUILD_ENABLE_DISPLAY=y
CONFIG_LUNASHELL_BUILD_ENABLE_TOUCH=y
CONFIG_LUNASHELL_BUILD_ENABLE_UI=n
CONFIG_LUNASHELL_BUILD_ENABLE_BOOT_UI=n
CONFIG_LUNASHELL_BUILD_ENABLE_BOOT_AUDIO=n
CONFIG_LUNASHELL_BUILD_ENABLE_WIFI=n
CONFIG_LUNASHELL_BUILD_ENABLE_BLUETOOTH=n
CONFIG_LUNASHELL_BUILD_ENABLE_PROVISIONING=n
CONFIG_LUNASHELL_BUILD_ENABLE_HTTP_API=n
CONFIG_LUNASHELL_BUILD_ENABLE_AUDIO=n
CONFIG_LUNASHELL_BUILD_ENABLE_WAKE_WORD=n
CONFIG_LUNASHELL_BUILD_ENABLE_POWER_INPUTS=n
CONFIG_LUNASHELL_BUILD_ENABLE_BATTERY=n
CONFIG_LUNASHELL_BUILD_ENABLE_IMU=n
CONFIG_LUNASHELL_BUILD_ENABLE_RTC=n
CONFIG_LUNASHELL_BUILD_ENABLE_GNSS=n
CONFIG_LUNASHELL_BUILD_ENABLE_REMOVABLE_STORAGE=n
CONFIG_LUNASHELL_BUILD_ENABLE_DISTANCE=n
