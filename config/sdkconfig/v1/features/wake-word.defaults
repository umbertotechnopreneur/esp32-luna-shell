# Opt-in shared platform feature; ordinary variants keep ESP-SR excluded.
CONFIG_LUNASHELL_BUILD_ENABLE_WAKE_WORD=y
CONFIG_FREERTOS_UNICORE=n
# Explicit PSRAM policy for AFE buffers, vendor allocations and static audio stacks.
CONFIG_SPIRAM_BOOT_INIT=y
CONFIG_SPIRAM_USE_MALLOC=y
CONFIG_SPIRAM_MALLOC_ALWAYSINTERNAL=0
CONFIG_SPIRAM_MALLOC_RESERVE_INTERNAL=65536
CONFIG_SPIRAM_ALLOW_BSS_SEG_EXTERNAL_MEMORY=y
CONFIG_FREERTOS_SUPPORT_STATIC_ALLOCATION=y
CONFIG_FREERTOS_TASK_CREATE_ALLOW_EXT_MEM=y
# The full Luna LVGL adapter must also remain off the voice/inference core.
CONFIG_BROOKESIA_GUI_LVGL_DISPLAY_SOURCE_TASK_CORE_ID=1
# A single software draw unit avoids additional unpinned LVGL raster workers.
CONFIG_LV_DRAW_SW_DRAW_UNIT_CNT=1
CONFIG_LUNASHELL_BUILD_WAKE_WORD_SOPHIA=y
CONFIG_LUNASHELL_BUILD_WAKE_WORD_STANDBY_LISTENING=y
CONFIG_LUNASHELL_BUILD_VOICE_AFE_SR_PROFILE_LOW_COST=y
CONFIG_MODEL_IN_FLASH=y
CONFIG_SR_NSN_WEBRTC=y
CONFIG_SR_VADN_WEBRTC=y
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="config/partitions/wake-word.csv"
CONFIG_SR_MN_CN_NONE=y
CONFIG_SR_MN_EN_NONE=y
