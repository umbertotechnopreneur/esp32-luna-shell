# Explicit development policy, applied after the hardware/profile layers.
CONFIG_LUNASHELL_BUILD_MODE_DEBUG=y
# CONFIG_LUNASHELL_BUILD_MODE_RELEASE is not set
CONFIG_LOG_DEFAULT_LEVEL_INFO=y
CONFIG_LOG_MAXIMUM_LEVEL_VERBOSE=y
CONFIG_BOOTLOADER_LOG_LEVEL_INFO=y
# Capture every task's saved stack over the existing USB console on a panic.
# PSRAM task stacks require UART output; no card or flash partition is written.
CONFIG_ESP_COREDUMP_ENABLE_TO_UART=y
CONFIG_ESP_COREDUMP_MAX_TASKS_NUM=64
CONFIG_ESP_COREDUMP_STACK_SIZE=2048
# CONFIG_ESP_COREDUMP_CAPTURE_DRAM is not set
CONFIG_PM_LIGHT_SLEEP_CALLBACKS=y
# The IDF 6.0.2 USB SOF guard caused cache-error reboots on this board.
CONFIG_USJ_NO_AUTO_LS_ON_CONNECTION=n
