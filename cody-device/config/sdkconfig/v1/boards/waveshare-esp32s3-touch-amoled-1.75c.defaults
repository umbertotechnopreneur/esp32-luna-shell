# Physical board selection; applied after interface/service defaults.
CONFIG_LUNASHELL_BUILD_BOARD_PROFILE_WAVESHARE_ESP32S3_TOUCH_AMOLED_1_75C=y
CONFIG_ESPTOOLPY_FLASHMODE_QIO=y
CONFIG_ESPTOOLPY_FLASHSIZE_32MB=y
CONFIG_ESPTOOLPY_FLASHSIZE="32MB"

# The supplied 1.75C schematic has no PCF85063, LC76G, TCA9554 or SD slot.
# Network/system time remains available through the canonical clock owner.
CONFIG_LUNASHELL_BUILD_RTC_DRIVER_NONE=y
CONFIG_LUNASHELL_BUILD_GNSS_DRIVER_NONE=y
CONFIG_LUNASHELL_BUILD_ENABLE_RTC=n
CONFIG_LUNASHELL_BUILD_ENABLE_GNSS=n
CONFIG_LUNASHELL_BUILD_ENABLE_REMOVABLE_STORAGE=n
