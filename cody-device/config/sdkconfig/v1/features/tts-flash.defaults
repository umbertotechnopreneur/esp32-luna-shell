# VBWR E

CONFIG_LUNASHELL_BUILD_ENABLE_TTS=y
CONFIG_LUNASHELL_TTS_DATA_FLASH=y
# CONFIG_LUNASHELL_TTS_BOOT_TEST_ITALIAN is not set
# CONFIG_FREERTOS_UNICORE is not set
# CONFIG_LUNASHELL_TTS_DATA_SD is not set
CONFIG_LUNASHELL_TTS_ENGINE_HEAP_BYTES=1048576
CONFIG_LUNASHELL_TTS_STACK_BYTES=65536
CONFIG_FREERTOS_TASK_CREATE_ALLOW_EXT_MEM=y
