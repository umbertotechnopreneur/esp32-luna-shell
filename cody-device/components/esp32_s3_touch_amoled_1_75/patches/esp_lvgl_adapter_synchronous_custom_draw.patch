+    /**
+     * @brief The custom callback returns only after every panel transfer is complete.
+     *
+     * Keep this false for the normal asynchronous callback contract. Set it true only when
+     * the callback waits for all transfers before returning. This lets one logical LVGL flush
+     * use multiple panel transfers without releasing the LVGL draw buffer on the first ISR.
+     */
+    bool waits_until_complete;
 } esp_lv_adapter_draw_bitmap_callbacks_t;
 
