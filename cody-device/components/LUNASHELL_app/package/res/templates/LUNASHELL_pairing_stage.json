{
    "type": "viewTemplate",
    "id": "LUNASHELL_pairing_stage",
    "node": {
        "type": "container",
        "bindings": {
            "placement.y": "viewport_y",
            "placement.height": "viewport_height",
            "style.paddingTop": "viewport_padding_top",
            "style.paddingBottom": "viewport_padding_bottom"
        },
        "commonProps": {
            "clickable": false,
            "scrollable": false
        },
        "style": {
            "radius": "160dp",
            "padding": "10dp",
            "paddingTop": "50dp",
            "paddingBottom": "6dp"
        },
        "layout": {
            "type": "flex",
            "flexFlow": "column",
            "mainAlign": "center",
            "crossAlign": "center",
            "gap": "4dp"
        },
        "placement": {
            "mode": "absolute",
            "align": "topMid",
            "x": "73dp",
            "y": "73dp",
            "width": "320dp",
            "height": "320dp"
        },
        "children": [
            {
                "type": "label",
                "id": "step",
                "bindings": {
                    "labelProps.text": "text",
                    "style.textColor": "color"
                },
                "labelProps": {
                    "text": "STEP 1 OF 5"
                },
                "style": {
                    "textColor": "#20dfc1",
                    "fontSize": "${constant.typography.micro}",
                    "textAlign": "center"
                },
                "placement": {
                    "width": "272dp",
                    "height": "wrap"
                }
            },
            {
                "type": "progressBar",
                "id": "progress",
                "commonProps": {
                    "hidden": false
                },
                "bindings": {
                    "commonProps.hidden": "hidden",
                    "rangeProps.value": "value"
                },
                "rangeProps": {
                    "value": 1,
                    "min": 0,
                    "max": 5
                },
                "style": {
                    "bgColor": "#173545",
                    "radius": "2dp"
                },
                "partStyles": {
                    "indicator": {
                        "bgColor": "#20dfc1",
                        "radius": "2dp"
                    }
                },
                "placement": {
                    "width": "124dp",
                    "height": "4dp"
                }
            },
            {
                "type": "label",
                "id": "title",
                "bindings": {
                    "labelProps.text": "text"
                },
                "labelProps": {
                    "text": "PAIR DEVICE"
                },
                "style": {
                    "textColor": "#f3f7fa",
                    "fontSize": "${constant.typography.heading}",
                    "textAlign": "center"
                },
                "placement": {
                    "width": "292dp",
                    "height": "wrap"
                }
            },
            {
                "type": "label",
                "id": "message",
                "bindings": {
                    "labelProps.text": "text"
                },
                "labelProps": {
                    "text": "Preparing pairing..."
                },
                "style": {
                    "textColor": "#ffffff",
                    "fontSize": "${constant.typography.detail}",
                    "textAlign": "center"
                },
                "placement": {
                    "width": "286dp",
                    "height": "wrap"
                }
            },
            {
                "type": "image",
                "id": "qr",
                "commonProps": {
                    "clickable": false,
                    "scrollable": false,
                    "hidden": true
                },
                "bindings": {
                    "commonProps.hidden": "hidden",
                    "imageProps.src": "src"
                },
                "imageProps": {
                    "src": ""
                },
                "style": {
                    "radius": "8dp"
                },
                "placement": {
                    "width": "140dp",
                    "height": "140dp"
                }
            },
            {
                "type": "label",
                "id": "detail",
                "bindings": {
                    "labelProps.text": "text"
                },
                "labelProps": {
                    "text": ""
                },
                "style": {
                    "textColor": "#b8cbd8",
                    "fontSize": "${constant.typography.caption}",
                    "textAlign": "center"
                },
                "placement": {
                    "width": "272dp",
                    "height": "wrap"
                }
            }
        ]
    }
}
