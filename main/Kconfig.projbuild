menu "LUNASHELL build profiles"

choice LUNASHELL_BUILD_PROFILE
    prompt "LUNASHELL firmware profile"
    default LUNASHELL_BUILD_PROFILE_FULL
    help
        Select whether to build the full Waveshare device experience or a
        reduced runtime with selected hardware and radio blocks removed from
        the firmware image.

config LUNASHELL_BUILD_PROFILE_FULL
    bool "Full Waveshare device runtime"

config LUNASHELL_BUILD_PROFILE_HEADLESS
    bool "Headless runtime"

endchoice

menu "LUNASHELL board hardware drivers"

choice LUNASHELL_BUILD_DISPLAY_DRIVER
    prompt "Display and touch board driver"
    default LUNASHELL_BUILD_DISPLAY_DRIVER_WAVESHARE_AMOLED
    help
        Select the physical display and touch implementation. The current
        Waveshare BSP owns both paths as one board-level driver.

config LUNASHELL_BUILD_DISPLAY_DRIVER_WAVESHARE_AMOLED
    bool "Waveshare 1.75 inch AMOLED with CST9217 touch"

config LUNASHELL_BUILD_DISPLAY_DRIVER_NONE
    bool "No display or touch hardware"

endchoice

choice LUNASHELL_BUILD_AUDIO_DRIVER
    prompt "Audio codec board driver"
    default LUNASHELL_BUILD_AUDIO_DRIVER_WAVESHARE_ES8311_ES7210
    help
        Select the board-owned audio transport. Input and output codecs are
        selected separately below so a product can include only a microphone,
        only a speaker, or a different future codec adapter.

config LUNASHELL_BUILD_AUDIO_DRIVER_WAVESHARE_ES8311_ES7210
    bool "Waveshare ES8311 speaker and ES7210 microphones"

config LUNASHELL_BUILD_AUDIO_DRIVER_NONE
    bool "No audio codec hardware"

endchoice

choice LUNASHELL_BUILD_AUDIO_OUTPUT_DRIVER
    prompt "Audio output codec"
    depends on LUNASHELL_BUILD_AUDIO_DRIVER_WAVESHARE_ES8311_ES7210
    default LUNASHELL_BUILD_AUDIO_OUTPUT_DRIVER_ES8311

config LUNASHELL_BUILD_AUDIO_OUTPUT_DRIVER_ES8311
    bool "ES8311 speaker codec"

config LUNASHELL_BUILD_AUDIO_OUTPUT_DRIVER_NONE
    bool "No speaker output hardware"

endchoice

choice LUNASHELL_BUILD_AUDIO_INPUT_DRIVER
    prompt "Audio input codec and microphone topology"
    depends on LUNASHELL_BUILD_AUDIO_DRIVER_WAVESHARE_ES8311_ES7210
    default LUNASHELL_BUILD_AUDIO_INPUT_DRIVER_ES7210_DUAL
    help
        Choose the physically populated microphone path. The mono ES7210
        option captures its first channel only; future codec adapters belong
        in this mutually exclusive choice.

config LUNASHELL_BUILD_AUDIO_INPUT_DRIVER_ES7210_DUAL
    bool "ES7210 dual microphones"

config LUNASHELL_BUILD_AUDIO_INPUT_DRIVER_ES7210_MONO
    bool "ES7210 single microphone"

config LUNASHELL_BUILD_AUDIO_INPUT_DRIVER_NONE
    bool "No microphone input hardware"

endchoice

choice LUNASHELL_BUILD_PMU_DRIVER
    prompt "PMU board driver"
    default LUNASHELL_BUILD_PMU_DRIVER_AXP2101

config LUNASHELL_BUILD_PMU_DRIVER_AXP2101
    bool "AXP2101 PMU"

config LUNASHELL_BUILD_PMU_DRIVER_NONE
    bool "No PMU hardware"

endchoice

choice LUNASHELL_BUILD_RTC_DRIVER
    prompt "RTC board driver"
    default LUNASHELL_BUILD_RTC_DRIVER_PCF85063

config LUNASHELL_BUILD_RTC_DRIVER_PCF85063
    bool "PCF85063 RTC"

config LUNASHELL_BUILD_RTC_DRIVER_NONE
    bool "No RTC hardware"

endchoice

choice LUNASHELL_BUILD_IMU_DRIVER
    prompt "IMU board driver"
    default LUNASHELL_BUILD_IMU_DRIVER_QMI8658
    help
        Choose one physical IMU driver. A selected driver reports its actual
        initialization error when the expected hardware is missing; it never
        probes unrelated chips as a fallback.

config LUNASHELL_BUILD_IMU_DRIVER_QMI8658
    bool "QMI8658 IMU"

config LUNASHELL_BUILD_IMU_DRIVER_NONE
    bool "No IMU hardware"

endchoice

choice LUNASHELL_BUILD_GNSS_DRIVER
    prompt "GNSS board driver"
    default LUNASHELL_BUILD_GNSS_DRIVER_LC76G

config LUNASHELL_BUILD_GNSS_DRIVER_LC76G
    bool "LC76G GNSS"

config LUNASHELL_BUILD_GNSS_DRIVER_NONE
    bool "No GNSS hardware"

endchoice

config LUNASHELL_BUILD_ENABLE_DISTANCE
    bool "Include external precision distance support"
    default n
    help
        Builds the calibrated distance service, its selected physical driver,
        and the matching device UI. Leave this disabled for the standard
        firmware image.

choice LUNASHELL_BUILD_DISTANCE_DRIVER
    prompt "External precision distance driver"
    depends on LUNASHELL_BUILD_ENABLE_DISTANCE
    default LUNASHELL_BUILD_DISTANCE_DRIVER_TOF400F_DUAL_UART
    help
        Select the distance hardware attached to the external GPIO16/17/18
        header. UART0 remains reserved for console diagnostics.

config LUNASHELL_BUILD_DISTANCE_DRIVER_TOF400F_DUAL_UART
    bool "Two TOF400F modules on shared TX and independent RX lines"

config LUNASHELL_BUILD_DISTANCE_DRIVER_NONE
    bool "No external distance driver"
    help
        Keeps the distance service stub and omits the distance UI even though
        the enclosing feature switch is enabled.

endchoice

endmenu

config LUNASHELL_BUILD_ENABLE_UI
    bool "Enable display and touch UI stack"
    depends on LUNASHELL_BUILD_DISPLAY_DRIVER_WAVESHARE_AMOLED
    default y if LUNASHELL_BUILD_PROFILE_FULL
    default n if LUNASHELL_BUILD_PROFILE_HEADLESS
    help
        Builds the Brookesia application runtime plus the Waveshare display
        path. The current BSP couples touch input to this stack, so disabling
        this option also removes touch support from the build.

config LUNASHELL_BUILD_ENABLE_BOOT_UI
    bool "Enable boot splash screen"
    depends on LUNASHELL_BUILD_ENABLE_UI
    default y

config LUNASHELL_BUILD_ENABLE_AUDIO
    bool "Enable selected speaker and microphone paths"
    depends on LUNASHELL_BUILD_AUDIO_DRIVER_WAVESHARE_ES8311_ES7210
    default y

config LUNASHELL_BUILD_ENABLE_VOICE_AFE
    bool "Enable ESP-SR 16 kHz voice AFE"
    depends on LUNASHELL_BUILD_ENABLE_AUDIO
    depends on LUNASHELL_BUILD_AUDIO_OUTPUT_DRIVER_ES8311
    depends on LUNASHELL_BUILD_AUDIO_INPUT_DRIVER_ES7210_DUAL || LUNASHELL_BUILD_AUDIO_INPUT_DRIVER_ES7210_MONO
    default n
    help
        Starts a dedicated 16 kHz PCM16 voice pipeline. It uses MR for one
        microphone or MMNR for two microphones, and keeps a speaker PCM
        reference ring for AEC. This is the speech-recognition profile, not a
        full-duplex conversation path.

choice LUNASHELL_BUILD_VOICE_AFE_SR_PROFILE
    prompt "Voice AFE speech-recognition profile"
    depends on LUNASHELL_BUILD_ENABLE_VOICE_AFE
    default LUNASHELL_BUILD_VOICE_AFE_SR_PROFILE_LOW_COST

config LUNASHELL_BUILD_VOICE_AFE_SR_PROFILE_LOW_COST
    bool "AEC SR low cost"

config LUNASHELL_BUILD_VOICE_AFE_SR_PROFILE_HIGH_PERF
    bool "AEC SR high performance"

endchoice

config LUNASHELL_BUILD_ENABLE_BOOT_AUDIO
    bool "Enable boot sound effect"
    depends on LUNASHELL_BUILD_ENABLE_AUDIO
    depends on LUNASHELL_BUILD_AUDIO_OUTPUT_DRIVER_ES8311
    default y

config LUNASHELL_BUILD_ENABLE_WIFI
    bool "Enable Wi-Fi station stack"
    default y

config LUNASHELL_BUILD_ENABLE_BLUETOOTH
    bool "Enable Bluetooth telemetry stack"
    default y

config LUNASHELL_BUILD_ENABLE_PROVISIONING
    bool "Enable Bluetooth Wi-Fi pairing flow"
    depends on LUNASHELL_BUILD_ENABLE_WIFI
    depends on LUNASHELL_BUILD_ENABLE_BLUETOOTH
    default y
    help
        Keeps the BLE transport used by the secure Wi-Fi provisioning flow.

config LUNASHELL_BUILD_ENABLE_IMU
    bool "Enable IMU motion pipeline"
    depends on LUNASHELL_BUILD_IMU_DRIVER_QMI8658
    default y

config LUNASHELL_BUILD_ENABLE_POWER_INPUTS
    bool "Enable button and power-management pipeline"
    depends on LUNASHELL_BUILD_PMU_DRIVER_AXP2101
    default y

config LUNASHELL_BUILD_ENABLE_RTC
    bool "Enable RTC time pipeline"
    depends on LUNASHELL_BUILD_RTC_DRIVER_PCF85063
    default y

config LUNASHELL_BUILD_ENABLE_GNSS
    bool "Enable GNSS position pipeline"
    depends on LUNASHELL_BUILD_GNSS_DRIVER_LC76G
    default y

endmenu
