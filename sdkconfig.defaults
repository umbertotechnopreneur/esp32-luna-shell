CONFIG_IDF_TARGET="esp32s3"
CONFIG_ESPTOOLPY_FLASHMODE_QIO=y
CONFIG_ESPTOOLPY_FLASHSIZE_16MB=y
CONFIG_ESPTOOLPY_FLASHSIZE="16MB"
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"

CONFIG_SPIRAM=y
CONFIG_SPIRAM_MODE_OCT=y
CONFIG_SPIRAM_SPEED_80M=y
CONFIG_SPIRAM_FETCH_INSTRUCTIONS=y
# Keep executable instructions in PSRAM for speed, but leave read-only data in
# flash so the declarative GUI retains enough external heap at runtime.
# CONFIG_SPIRAM_RODATA is not set
# CONFIG_SPIRAM_XIP_FROM_PSRAM is not set
# Brookesia's declarative DOM performs many small allocations. Match the
# official Waveshare Brookesia board profile so normal allocations prefer
# PSRAM and the internal reserve remains available for DMA and task stacks.
CONFIG_SPIRAM_MALLOC_ALWAYSINTERNAL=0
CONFIG_SPIRAM_MALLOC_RESERVE_INTERNAL=65536
CONFIG_SPIRAM_TRY_ALLOCATE_WIFI_LWIP=y
# Put eligible Wi-Fi, Bluetooth, lwIP, and explicitly annotated application
# BSS in PSRAM so internal SRAM remains contiguous for display DMA.
CONFIG_SPIRAM_ALLOW_BSS_SEG_EXTERNAL_MEMORY=y
CONFIG_ESP_DEFAULT_CPU_FREQ_MHZ_240=y
CONFIG_ESP32S3_INSTRUCTION_CACHE_32KB=y
CONFIG_ESP32S3_DATA_CACHE_64KB=y
CONFIG_ESP32S3_DATA_CACHE_LINE_64B=y
CONFIG_COMPILER_OPTIMIZATION_PERF=y

# Let ESP-IDF scale the CPU while active and enter automatic Light-sleep once
# every application task and driver has released its runtime requirements.
CONFIG_PM_ENABLE=y
CONFIG_FREERTOS_USE_TICKLESS_IDLE=y
CONFIG_FREERTOS_IDLE_TIME_BEFORE_SLEEP=3
CONFIG_PM_LIGHT_SLEEP_CALLBACKS=y
# Keep the USB Serial/JTAG connection monitor out of the PM-lock path. On this
# ESP-IDF 6.0.2 target its tick hook can acquire/release that lock while a flash
# operation has disabled cache, causing a repeatable Cache error reboot.
CONFIG_USJ_NO_AUTO_LS_ON_CONNECTION=n
# CPU-domain retention consumes scarce internal RAM on this PSRAM-heavy UI
# image. Keep the core retained for the first measured power profile.
# CONFIG_PM_POWER_DOWN_CPU_IN_LIGHT_SLEEP is not set
CONFIG_FREERTOS_HZ=1000
CONFIG_LOG_DEFAULT_LEVEL_INFO=y
CONFIG_LOG_MAXIMUM_LEVEL_VERBOSE=y
# Hardware startup still performs several synchronous probes before the
# dedicated Brookesia task takes over.
CONFIG_ESP_MAIN_TASK_STACK_SIZE=12288
CONFIG_ESP_TIMER_TASK_STACK_SIZE=6144

CONFIG_ESP_LVGL_ADAPTER_ENABLE_DECODER=y
CONFIG_ESP_LVGL_ADAPTER_ENABLE_FS=y
CONFIG_LV_CONF_MINIMAL=y
CONFIG_LV_OS_FREERTOS=y
CONFIG_LV_TXT_ENC_UTF8=y
CONFIG_LV_USE_CLIB_MALLOC=y
CONFIG_LV_USE_CLIB_STRING=y
CONFIG_LV_USE_CLIB_SPRINTF=y
CONFIG_LV_DEF_REFR_PERIOD=15
CONFIG_LV_OBJ_STYLE_CACHE=y
CONFIG_LV_DRAW_SW_DRAW_UNIT_CNT=2
CONFIG_LV_USE_DRAW_SW_COMPLEX_GRADIENTS=y
# Reuse the repeated rounded-button and chrome shadow masks instead of
# rasterizing them from scratch after every invalidation.
CONFIG_LV_DRAW_SW_SHADOW_CACHE_SIZE=48
CONFIG_LV_DRAW_SW_CIRCLE_CACHE_SIZE=16
CONFIG_LV_USE_LOG=y
CONFIG_LV_LOG_PRINTF=y
CONFIG_LV_CACHE_DEF_SIZE=0
CONFIG_LV_IMAGE_HEADER_CACHE_DEF_CNT=0
CONFIG_LV_FONT_MONTSERRAT_8=y
CONFIG_LV_FONT_MONTSERRAT_10=y
CONFIG_LV_FONT_MONTSERRAT_12=y
CONFIG_LV_FONT_MONTSERRAT_16=y
CONFIG_LV_FONT_MONTSERRAT_20=y
CONFIG_LV_FONT_MONTSERRAT_24=y
CONFIG_LV_FONT_MONTSERRAT_32=y
CONFIG_LV_USE_SNAPSHOT=y
CONFIG_LV_BUILD_EXAMPLES=n
CONFIG_LV_FS_DEFAULT_DRIVER_LETTER=65
CONFIG_LV_FS_STDIO_LETTER=65
CONFIG_LV_FS_POSIX_LETTER=65
CONFIG_LV_USE_LODEPNG=y

CONFIG_BROOKESIA_GUI_INTERFACE_ENABLE_EXAMPLES=n
CONFIG_BROOKESIA_GUI_LVGL_DISPLAY_SOURCE_BUFFER_HEIGHT=50
CONFIG_BROOKESIA_GUI_LVGL_DISPLAY_SOURCE_REQUIRE_DOUBLE_BUFFER=y

# Measure real per-core utilization from each FreeRTOS idle task. Keep the
# 32-bit counter expected by Brookesia; unsigned sample deltas tolerate wrap.
CONFIG_FREERTOS_GENERATE_RUN_TIME_STATS=y
CONFIG_FREERTOS_RUN_TIME_COUNTER_TYPE_U32=y
CONFIG_FREERTOS_RUN_TIME_STATS_USING_ESP_TIMER=y

# Keep Brookesia's three scheduler domains available: app startup synchronously
# posts GUI work, and a single worker deadlocks waiting on itself. Their large
# stacks stay in PSRAM. LUNASHELL settings have a fixed internal-stack executor, and
# Brookesia Storage uses one internal secondary worker.
CONFIG_BROOKESIA_SYSTEM_CORE_WORKER_NUM=3
CONFIG_BROOKESIA_SYSTEM_CORE_WORKER_STACK_SIZE=65536
CONFIG_BROOKESIA_SYSTEM_CORE_WORKER_STACK_IN_EXT=y
CONFIG_BROOKESIA_SERVICE_MANAGER_WORKER_STACK_IN_EXT=y
CONFIG_BROOKESIA_SERVICE_MANAGER_SECONDARY_SCHEDULER_ENABLE=y
CONFIG_BROOKESIA_SERVICE_MANAGER_SECONDARY_SCHEDULER_WORKER_STACK_SIZE=7168
CONFIG_BROOKESIA_SERVICE_MANAGER_SECONDARY_SCHEDULER_WORKER_NUM=1

CONFIG_BROOKESIA_HAL_ADAPTOR_ENABLE_STORAGE_DEVICE=y
CONFIG_BROOKESIA_HAL_ADAPTOR_STORAGE_ENABLE_FILE_SYSTEM_IMPL=y
CONFIG_BROOKESIA_HAL_ADAPTOR_STORAGE_FILE_SYSTEM_ENABLE_LITTLEFS=y
CONFIG_BROOKESIA_HAL_ADAPTOR_STORAGE_FILE_SYSTEM_LITTLEFS_BASE_PATH="/littlefs"
CONFIG_BROOKESIA_HAL_ADAPTOR_STORAGE_FILE_SYSTEM_LITTLEFS_PARTITION_LABEL="littlefs_data"
CONFIG_BROOKESIA_HAL_ADAPTOR_STORAGE_FILE_SYSTEM_LITTLEFS_FORMAT_IF_MOUNT_FAILED=n
CONFIG_BROOKESIA_HAL_ADAPTOR_STORAGE_FILE_SYSTEM_ENABLE_FATFS_FLASH=n
CONFIG_BROOKESIA_HAL_ADAPTOR_STORAGE_ENABLE_KEY_VALUE_IMPL=y
# The HAL adaptor intentionally owns only internal LittleFS/NVS. The firmware
# owns the removable microSD lifecycle and never enables the adaptor's SDCARD
# backend.
CONFIG_BOOST_MATH_ENABLED=n
CONFIG_BOOST_SERIALIZATION_ENABLED=n

CONFIG_BT_ENABLED=y
CONFIG_BT_BLUEDROID_ENABLED=n
CONFIG_BT_NIMBLE_ENABLED=y
CONFIG_BT_NIMBLE_ROLE_CENTRAL=n
CONFIG_BT_NIMBLE_ROLE_OBSERVER=n
CONFIG_BT_NIMBLE_MAX_CONNECTIONS=1
CONFIG_BT_NIMBLE_MEM_ALLOC_MODE_EXTERNAL=y
# The ESP32-S3 controller counts advertising and connections as separate BLE
# activities. Provisioning needs one advertising instance plus one peripheral
# connection, so two slots are the functional minimum (about 828 B per slot).
CONFIG_BT_CTRL_BLE_MAX_ACT=2

# This product never scans and does not expose controller direct-test mode.
# Exclude both features so their controller state cannot consume scarce
# internal DMA memory needed by the advertising/peripheral path.
CONFIG_BT_CTRL_DTM_ENABLE=n
CONFIG_BT_CTRL_BLE_SCAN=n

# The firmware exposes only GAP, GATT, and Device Information. Keep the
# optional NimBLE profile services out of the image and their static tables.
# CONFIG_BT_NIMBLE_PROX_SERVICE is not set
# CONFIG_BT_NIMBLE_ANS_SERVICE is not set
# CONFIG_BT_NIMBLE_CTS_SERVICE is not set
# CONFIG_BT_NIMBLE_HTP_SERVICE is not set
# CONFIG_BT_NIMBLE_IPSS_SERVICE is not set
# CONFIG_BT_NIMBLE_TPS_SERVICE is not set
# CONFIG_BT_NIMBLE_IAS_SERVICE is not set
# CONFIG_BT_NIMBLE_LLS_SERVICE is not set
# CONFIG_BT_NIMBLE_SPS_SERVICE is not set
# CONFIG_BT_NIMBLE_HR_SERVICE is not set
# CONFIG_BT_NIMBLE_BAS_SERVICE is not set
CONFIG_BT_NIMBLE_DIS_SERVICE=y
CONFIG_BT_NIMBLE_GAP_SERVICE=y
CONFIG_BT_NIMBLE_GATT_SERVER=y

# Allow the ESP32-S3 controller to sleep between BLE events. This board has no
# verified external 32 kHz crystal, so use the supported main-XTAL clock path.
CONFIG_BT_CTRL_MODEM_SLEEP=y
CONFIG_BT_CTRL_MODEM_SLEEP_MODE_1=y
CONFIG_BT_CTRL_LPCLK_SEL_MAIN_XTAL=y
CONFIG_BT_CTRL_MAIN_XTAL_PU_DURING_LIGHT_SLEEP=y
# ESP32-S3 BLE controller build 51d9dfd requests 1100 bytes of retention RAM
# when MAC/BB power-down is enabled. This board exposes no allocatable block
# with MALLOC_CAP_RETENTION, so keep controller modem sleep but leave MAC/BB
# retention power-down disabled.
CONFIG_ESP_PHY_MAC_BB_PD=n

# IDF 6 moves provisioning to the external network_provisioning component and
# disables protocomm Security 1 by default. Keep the existing BLE protocol.
CONFIG_NETWORK_PROV_NETWORK_TYPE_WIFI=y
CONFIG_ESP_PROTOCOMM_SUPPORT_SECURITY_VERSION_1=y

# Keep the Wi-Fi DMA footprint bounded so the BLE controller can still acquire
# its required contiguous 0x7800-byte exchange-memory block. Four RX/TX buffers
# are sufficient for the provisioning and telemetry traffic on this product.
CONFIG_ESP_WIFI_STATIC_RX_BUFFER_NUM=4
CONFIG_ESP_WIFI_DYNAMIC_RX_BUFFER_NUM=12
CONFIG_ESP_WIFI_STATIC_TX_BUFFER=y
CONFIG_ESP_WIFI_STATIC_TX_BUFFER_NUM=4
CONFIG_ESP_WIFI_CACHE_TX_BUFFER_NUM=8
CONFIG_ESP_WIFI_RX_MGMT_BUF_NUM_DEF=3
CONFIG_ESP_WIFI_MGMT_SBUF_NUM=6

CONFIG_BSP_SD_MOUNT_POINT="/sdcard"
CONFIG_FATFS_LFN_HEAP=y

# The external dual-TOF distance feature is opt-in for product-specific builds.
# CONFIG_LUNASHELL_BUILD_ENABLE_DISTANCE is not set

# Keep the receive block-ack window within the configured Wi-Fi RX buffers.
CONFIG_ESP_WIFI_RX_BA_WIN=4

# Boost.Asio in the Brookesia runtime compiles IPv6 socket types even when the
# product currently uses IPv4 flows.
CONFIG_LWIP_IPV6=y

# Waveshare board power management uses the AXP2101 over the shared I2C bus.
CONFIG_XPOWERS_CHIP_AXP2101=y
CONFIG_XPOWERS_ESP_IDF_NEW_API=y
